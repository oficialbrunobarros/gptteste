{
  "name": "pumpfun-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulador de scalping (paper trading) para memecoins da Pump.fun",
  "scripts": {
    "start": "tsx src/main.ts",
    "sample": "tsx scripts/sample.ts",
    "report": "tsx src/reports/cli.ts",
    "backtest-params": "tsx src/reports/backtest.ts",
    "test": "vitest run",

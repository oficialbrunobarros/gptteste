# Copie para .env e preencha o que precisar. Nenhum valor aqui é obrigatório.

# Filtro Jev (TypeSafe System One). Sem esta chave o filtro fica desligado.
TYPESAFE_API_KEY=

# Modo do feed: pumpportal (padrão) ou synthetic (gerador sintético para testes offline)
FEED_MODE=

# Nível de log do pino: trace | debug | info | warn | error
LOG_LEVEL=info

# Porta do painel (sobrescreve config.yaml)
PORT=
